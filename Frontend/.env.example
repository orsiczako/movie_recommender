# Frontend Development Configuration
VITE_PORT=3001
VITE_API_BASE_URL=http://localhost:3000

# Production Configuration (will be overridden by Vercel environment variables)
# VITE_API_BASE_URL will be set to Railway backend URL in Vercel dashboard

# Google Gemini AI API Key - Get this from Google AI Studio
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# AI Service Configuration
VITE_AI_MAX_RETRIES=3
VITE_AI_TIMEOUT=10000
VITE_AI_MAX_MESSAGE_LENGTH=500