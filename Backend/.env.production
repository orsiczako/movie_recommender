# Production Environment Variables for Railway
# Copy this to .env and fill in your production values

# Server Configuration
PORT=3000

# Database Configuration (Railway MySQL)
DB_HOST=your-railway-mysql-host
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASS=your-railway-mysql-password

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-for-production
BACKEND_API_KEY=your-production-backend-api-key
FRONTEND_API_KEY=your-production-frontend-api-key

# CORS Configuration
CORS_ORIGIN=https://your-vercel-frontend-url.vercel.app
FRONTEND_URL=https://your-vercel-frontend-url.vercel.app

# TMDB API
TMDB_API_KEY=4797a155d56ae6cb58b2579f45663e7f

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password