# Production Environment Variables for Render.com
# These will be set automatically via render.yaml and Render dashboard

# Server Configuration
PORT=10000
NODE_ENV=production

# Database Configuration (Render PostgreSQL)
# These are automatically provided by Render when you create a PostgreSQL database
DB_TYPE=postgres
DB_HOST=<automatically-provided-by-render>
DB_PORT=5432
DB_NAME=<automatically-provided-by-render>
DB_USER=<automatically-provided-by-render>
DB_PASSWORD=<automatically-provided-by-render>

# Security (automatically generated by Render)
JWT_SECRET=<automatically-generated-by-render>

# CORS Configuration (update with your actual frontend URL)
CORS_ORIGIN=https://your-vercel-frontend-url.vercel.app
FRONTEND_URL=https://your-vercel-frontend-url.vercel.app

# TMDB API (MANUAL SETUP REQUIRED)
TMDB_API_KEY=your-tmdb-api-key-here

# Email Configuration (MANUAL SETUP REQUIRED)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password